NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/cinego?replicaSet=rs0&directConnection=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-48-random-characters-before-running
PAYMENT_MODE=demo
# Proposed policies, not approved cinema business rules
HOLD_MINUTES=10
CHANGE_CUTOFF_HOURS=12
REFUND_PERCENT=100
POINTS_PER_VND=10000

# Used by local Docker Compose; npm run setup generates random values.
MONGO_ROOT_PASSWORD=generate-a-random-secret
MONGO_APP_PASSWORD=generate-another-random-secret

# Email quên mật khẩu (tùy chọn). Bỏ trống SMTP_HOST thì khi chạy thử, liên kết đặt lại
# mật khẩu được in ra cửa sổ chạy server. Khi dùng SMTP cần: npm install nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
