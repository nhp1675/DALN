NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/cinego?replicaSet=rs0&directConnection=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-48-random-characters-before-running
PAYMENT_MODE=demo
# Proposed policies, not approved cinema business rules
HOLD_MINUTES=10
CHANGE_CUTOFF_HOURS=12
REFUND_PERCENT=100
POINTS_PER_VND=10000

# Used by local Docker Compose; npm run setup generates random values.
MONGO_ROOT_PASSWORD=generate-a-random-secret
MONGO_APP_PASSWORD=generate-another-random-secret

# Gmail SMTP cho email xác minh tài khoản, mã MFA và đặt lại mật khẩu.
# Dùng Google App Password, không dùng mật khẩu đăng nhập Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=replace-with-google-app-password
MAIL_FROM=CineGo <your-address@gmail.com>

# lệnh kiểm tra tài khoản admin đã đăng ký
# node --input-type=module -e 'import mongoose from "mongoose"; import { config } from "./server/config.js"; import { User } from "./server/models.js"; try { await mongoose.connect(config.MONGODB_URI); const admins = await User.find({ role: "admin" }).select("name email active emailVerified createdAt").lean(); console.table(admins.map(({ _id, ...user }) => ({ id: String(_id), ...user }))); } finally { await mongoose.disconnect(); }'