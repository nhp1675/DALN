{
  "name": "cinego-flutter-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "seed": "node scripts/seed.js",
    "admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "setup": "node scripts/setup-local.js",
    "test:unit": "node --test tests/security-unit.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "mongodb-memory-server": "^10.2.1",
    "supertest": "^7.1.4"
  }
}
